# ClusterWeave trusted single-user local profile
# Run ./bin/init_local_instance.sh to create .env with generated secrets.
CLUSTERWEAVE_BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
CLUSTERWEAVE_DOCKER_PLATFORM=linux/amd64
CLUSTERWEAVE_PUBLIC_BASE_URL=http://127.0.0.1:8080/
CLUSTERWEAVE_PUBLIC_MODE=1
CLUSTERWEAVE_ACCESS_PROFILE=local-owner
CLUSTERWEAVE_JOB_RETENTION_DAYS=never
CLUSTERWEAVE_ALLOW_NEVER_EXPIRE_JOBS=1
CLUSTERWEAVE_SUBMISSIONS_OPEN=1
CLUSTERWEAVE_MAX_ACCESSIONS=50
CLUSTERWEAVE_MAX_GENOME_FILES=50
CLUSTERWEAVE_MAX_CPUS_PER_JOB=4
CLUSTERWEAVE_WORKER_CPU_LIMIT=4
CLUSTERWEAVE_WORKER_MEM_LIMIT=16g
PIPELINE_CPUS=4
CLUSTERWEAVE_JOB_TOKEN_SECRET=GENERATE_LOCALLY
CLUSTERWEAVE_ADMIN_TOKEN=GENERATE_LOCALLY

# Recommended fresh setup: separate worker-only bounded accession cache.
CLUSTERWEAVE_ACCESSION_CACHE_ROOT=/var/cache/clusterweave/accessions
CLUSTERWEAVE_ACCESSION_CACHE_MAX_BYTES=10737418240
CLUSTERWEAVE_ACCESSION_CACHE_MAX_ENTRIES=256
CLUSTERWEAVE_ACCESSION_CACHE_MAX_AGE_SECONDS=2592000
# Explicit opt-in: no or unless-stopped; browser opening occurs only in the launcher.
CLUSTERWEAVE_LOCAL_RESTART_POLICY=no
CLUSTERWEAVE_LOCAL_OPEN_BROWSER=0
CLUSTERWEAVE_LOCAL_PREPARED_ONLY=1
