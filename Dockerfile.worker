FROM docker:29.6.1-cli AS docker-cli

FROM antismash/standalone:8.0.4

USER root

# The trusted local profile launches pinned sibling tool containers through the
# host socket. Ship a known Docker client instead of bind-mounting a
# host-specific /usr/bin/docker path (which is absent on Docker Desktop).
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gzip \
        hmmer \
        r-base-core \
        rsync \
        tar \
        unzip \
    && rm -rf /var/lib/apt/lists/*

COPY bin/install_plantismash_engine.sh /tmp/install_plantismash_engine.sh
RUN bash /tmp/install_plantismash_engine.sh && rm /tmp/install_plantismash_engine.sh

WORKDIR /app
COPY web/worker.py /app/worker.py
COPY web/researcher_report.py web/tool_runtime.py web/resource_usage.py web/stage_runner.py /app/
COPY web/accession_catalog.py /app/accession_catalog.py
COPY web/cache_status.py /app/cache_status.py
COPY web/bigscape_public_db.py /app/bigscape_public_db.py
COPY web/canonical_pipeline.py /app/canonical_pipeline.py
COPY web/genbank_readiness.py web/plant_annotation.py /app/
COPY web/job_store.py /app/job_store.py
COPY web/cohort_gate.py web/cohort_resume.py /app/
COPY web/legacy_job_results.py /app/legacy_job_results.py
COPY web/notifications.py /app/notifications.py
COPY web/public_results.py /app/public_results.py
COPY web/result_policy.py /app/result_policy.py
COPY web/result_attestation.py /app/result_attestation.py
COPY web/resource_policy.py /app/resource_policy.py
COPY web/runtime_capabilities.py /app/runtime_capabilities.py
COPY web/slurm_backend.py /app/slurm_backend.py
COPY web/taxon_routing.py /app/taxon_routing.py
COPY web/scientific_profiles.py /app/scientific_profiles.py
COPY web/entrypoint-worker.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh

WORKDIR /clusterweave
COPY *.sh /clusterweave/
COPY CITATION.cff /clusterweave/CITATION.cff
COPY LICENSE THIRD_PARTY.md /clusterweave/
COPY bin/ /clusterweave/bin/
COPY config/ /clusterweave/config/
COPY visuals/ascii_clusterweave.txt /clusterweave/visuals/ascii_clusterweave.txt
COPY scripts/ /clusterweave/scripts/
COPY web/local_setup.py /clusterweave/web/local_setup.py
COPY web/tool_runtime.py /clusterweave/web/tool_runtime.py
COPY web/resource_policy.py /clusterweave/web/resource_policy.py
COPY web/scientific_profiles.py /clusterweave/web/scientific_profiles.py
COPY web/plant_annotation.py /clusterweave/web/plant_annotation.py
COPY web/genbank_readiness.py /clusterweave/web/genbank_readiness.py
COPY web/taxon_routing.py /clusterweave/web/taxon_routing.py
COPY web/cohort_gate.py web/researcher_report.py /clusterweave/web/
COPY web/accession_catalog.py /clusterweave/web/accession_catalog.py
COPY web/static/assets/progress-tree-contract.json /clusterweave/web/static/assets/progress-tree-contract.json
COPY software/funbgcex/ /clusterweave/software/funbgcex/
COPY software/funannotate/ /clusterweave/software/funannotate/
COPY software/phylogeny/ /clusterweave/software/phylogeny/

RUN chmod +x /clusterweave/*.sh /clusterweave/scripts/ncbi/*.sh /clusterweave/software/funbgcex/*.sh /clusterweave/software/funannotate/*.sh /clusterweave/software/phylogeny/*.sh || true

RUN mkdir -p /data/uploads /data/jobs /databases/antismash /databases/pfam

ENV DATA_DIR=/data
ENV ANTISMASH_DB_DIR=/databases/antismash
ENV PFAM_DIR=/databases/pfam
ENV CLUSTERWEAVE_ROOT=/clusterweave
ENV CLUSTERWEAVE_SOFTWARE_ROOT=/data/software

ENTRYPOINT ["/app/entrypoint.sh"]

COPY web/plant_identity.py /app/plant_identity.py
COPY web/plant_identity.py /clusterweave/web/plant_identity.py
COPY software/plantismash/sources.lock.json /clusterweave/software/plantismash/sources.lock.json
COPY web/plant_versions.py /app/plant_versions.py
COPY web/plant_versions.py /clusterweave/web/plant_versions.py
COPY software/plantismash/runtime.lock.json /clusterweave/software/plantismash/runtime.lock.json
